# SSH 跳板通道設定範例
# 複製成 .env.tunnel 並填入真實值（.env.tunnel 已被 .gitignore 忽略，不會上傳）
#
#   cp .env.tunnel.example .env.tunnel
#
# 用途：db-tunnel.ps1 讀取此設定，建立 本機 -> 跳板機 -> 內網DB 的 SSH 通道
TUNNEL_JUMP_HOST=your-jump-host.example.com
TUNNEL_SSH_USER=your-ssh-user
TUNNEL_SSH_PASSWORD=your-ssh-password
TUNNEL_DB_HOST=10.0.0.1
TUNNEL_DB_PORT=3306
TUNNEL_LOCAL_PORT=3306
