# ═══ 统一环境变量范例 ═══
# 复制为 .env 并填入真实值（根目录 .env 已被 .gitignore 忽略，不会上传）：
#   cp .env.example .env
#
# 后端 apps/api 与 前端 apps/web(Vite) 都读取「仓库根目录」的这一个 .env。
# 安全：只有 VITE_ 前缀的变量会被打包进浏览器；DB / JWT / AI 金钥等仅后端可见。

# ── 后端 apps/api ──
PORT=4000
# 部署到正式区时，用 npm start（会设 NODE_ENV=production）→ 使用 DATABASE_URL_PROD
DATABASE_URL_DEV=mysql://user:pass@host:3306/db_dev
DATABASE_URL_PROD=mysql://user:pass@127.0.0.1:3306/db_prod
JWT_SECRET=请填至少16字元的强密钥
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173

# AI 问答（OpenAI 相容 gateway；URL 为 base，程式会自动接 /v1/chat/completions，勿含 /v1）
OLLAMA_API_URL=https://your-gateway.example.com
OLLAMA_API_KEY=your-api-key
OLLAMA_MODEL=gemma4:latest

# ── 前端 apps/web（Vite；仅 VITE_ 前缀会进浏览器）──
# 开发用 /api（走 vite 代理）；正式区填后端完整网址，如 https://api.example.com
VITE_API_BASE=/api

# ── 仅 Prisma CLI 需要（db pull / migrate）；app 运行时不需要（运行时由程式覆写连线）──
# DATABASE_URL=mysql://user:pass@host:3306/db
