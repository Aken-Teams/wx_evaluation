# 複製成 .env 並填入實際值（.env 已被 .gitignore 忽略）
PORT=4000
NODE_ENV=development

# 經 SSH 通道連無錫 DB（先啟動：專案根目錄 .\db-tunnel.ps1 start）
DATABASE_URL=mysql://vendor_rw:PASSWORD@127.0.0.1:3306/vendor_assessment

# JWT 密鑰（必填，無預設值；用以下指令產生強密鑰）
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# 前端來源（CORS 白名單，逗號分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:12009
