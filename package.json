{
  "name": "vendor-assessment-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "prestart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db-tunnel.ps1 start",
    "start": "npm --prefix apps/api start",
    "dev:legacy": "concurrently -k -n API,WEB -c cyan,green \"npm --prefix server run dev\" \"vite\"",
    "tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db-tunnel.ps1 start",
    "tunnel:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db-tunnel.ps1 stop",
    "tunnel:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db-tunnel.ps1 status",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "extract:yearly": "node --loader esbuild-node-loader scripts/extract-yearly-columns.mjs || node scripts/extract-yearly-columns.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/lab": "^5.0.0-alpha.140",
    "@mui/material": "^5.18.0",
    "@mui/x-data-grid": "^6.11.2",
    "axios": "^1.4.0",
    "mysql2": "^3.14.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0",
    "xlsx": "^0.18.5",
    "html2canvas": "^1.4.1",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "typescript": "^5.0.2",
    "vite": "^5.4.11"
  }
}
