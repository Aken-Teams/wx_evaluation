# 服務器端口配置
# 修改此值以更改服務器監聽的端口
PORT=3001

# 維護模式開關
# 設為 true 時系統進入維護模式
MAINTENANCE_MODE=false

# 資料庫連接字串
# 格式: mysql://用戶名:密碼@主機:端口/資料庫名
# 請替換為您的實際資料庫連接資訊
DATABASE_URL=mysql://username:password@host:port/database

# JWT 密鑰
# 用於生成和驗證 JWT token，生產環境請使用強密碼
# 生成強密鑰指令: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secret-key-here

# 維護模式預設帳號（可選）
# MAINTENANCE_USERNAME=admin
# MAINTENANCE_PASSWORD=admin123

# Log 等級（debug | info | warn | error）
# 開發環境建議 debug，生產環境建議 info 或 warn
LOG_LEVEL=info

# Ollama LLM 設定（AI 問答助手）
# API 端點位址
OLLAMA_API_URL=
# API 金鑰
OLLAMA_API_KEY=your-ollama-api-key-here
# 模型名稱
OLLAMA_MODEL=llama3.2
